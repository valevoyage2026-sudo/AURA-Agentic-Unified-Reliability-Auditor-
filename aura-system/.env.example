# ==========================================
# AURA System - Environment Configuration
# ==========================================

# General Configuration
ENVIRONMENT=development
LOG_LEVEL=info

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
REDIS_PORT=6379
OLLAMA_PORT=11434

# PostgreSQL Configuration
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura_password
POSTGRES_DB=aura_db

# Neo4j Configuration
NEO4J_USER=neo4j
NEO4J_PASSWORD=aura_password123

# LLM Providers & API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o
OLLAMA_MODEL=llama3

# AURA Pipeline Settings
MAX_ITERATIONS=2
